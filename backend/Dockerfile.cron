# syntax=docker/dockerfile:1
FROM node:22-alpine AS base
WORKDIR /usr/src/app

RUN apk add --no-cache python3 make g++

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-alpine AS runner
WORKDIR /usr/src/app

# alpine's built-in busybox crond is used (no extra package needed)
ENV NODE_ENV=production

RUN addgroup -S nodeapp && adduser -S nodeapp -G nodeapp

COPY --from=base /usr/src/app/node_modules ./node_modules
COPY . .
COPY docker/crontab /etc/crontabs/root

RUN chown -R nodeapp:nodeapp /usr/src/app \
    && chmod 0600 /etc/crontabs/root

# crond must run as root to read /etc/crontabs/root and manage its own logging;
# the actual job commands below still execute as the node process they spawn
CMD ["crond", "-f", "-l", "2"]
